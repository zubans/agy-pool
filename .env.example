# Настройки agy-pool. Скопируйте в .env (make up делает это сам, если .env нет).
# Длительности — целым числом секунд.

# --- Запуски agy ---
# Предел ожидания ответа модели, с.
AGY_TIMEOUT_MAX=600
# Одновременных запусков agy на аккаунт.
AGY_CONCURRENCY=2

# --- Остывание учётных данных ---
# При лимите без срока сброса, с.
AGY_QUOTA_COOLDOWN=3600
# При ошибке входа, с.
AGY_AUTH_COOLDOWN=600
# При отказе по региону, с.
AGY_REGION_COOLDOWN=86400
# Недоступный OpenAI-совместимый сервер, с.
AGY_ENDPOINT_COOLDOWN=300
# Вернувшийся аккаунт с высшим приоритетом сразу становится активным.
AGY_PREFER_PRIMARY=false

# --- Журнал запросов ---
# Хранить request_log, дней.
AGY_LOG_DAYS=90

# --- Вложения ---
# Вложений на запрос.
AGY_ATTACH_MAX_FILES=10
# Вложений на запрос всего, байт.
AGY_ATTACH_MAX_BYTES=209715200

# --- Секреты ---
# Ключ шифрования API-ключей в БД: base64 от 32 случайных байт (openssl rand -base64 32).
# Пока необязателен; если задан, проверяется при старте.
AGY_SECRETS_KEY=

# --- Деньги и время ---
# Валюта цен моделей.
AGY_CURRENCY=USD
# Часовой пояс границ суток и месяцев для лимитов.
AGY_TIMEZONE=Europe/Moscow

# --- Очередь ---
# Адрес NATS.
NATS_URL=nats://nats:4222
# Сколько хранить результаты асинхронных запросов, с.
AGY_JOBS_TTL=86400
# Попыток выполнить задачу из очереди.
AGY_JOB_MAX_ATTEMPTS=5

# --- Навыки и песочница ---
# Сколько хранить файлы-результаты навыков, с.
AGY_FILES_TTL=86400
# Лимиты песочницы на запрос: ядра, память (байты или с суффиксом KiB/MiB/GiB), время, с.
AGY_SANDBOX_CPU=2
AGY_SANDBOX_MEMORY=2GiB
AGY_SANDBOX_TIMEOUT=300
# Адрес исполнителя песочниц.
AGY_SANDBOXD_URL=http://sandboxd:8090

# --- Служебные ---
# Адрес HTTP-сервера внутри контейнера.
AGY_HTTP_ADDR=:8080
# Корень данных: accounts, skills, work.
AGY_DATA_DIR=/data
# Уровень журнала: debug, info, warn, error.
AGY_LOG_LEVEL=info

# --- PostgreSQL ---
# Учётные данные контейнера postgres; DATABASE_URL должен им соответствовать.
POSTGRES_DB=agy
POSTGRES_USER=agy
POSTGRES_PASSWORD=agy
DATABASE_URL=postgres://agy:agy@postgres:5432/agy?sslmode=disable

# --- Локальная разработка ---
# Только для make up-dev (compose.dev.yaml): порты на 127.0.0.1 хоста.
# Раскомментируйте и поменяйте, если порт на хосте занят.
# AGY_DEV_HTTP_PORT=8080
# AGY_DEV_PG_PORT=5432
# AGY_DEV_NATS_PORT=4222
# AGY_DEV_NATS_MON_PORT=8222
